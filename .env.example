# Frontend API base URL; keep the /api/contact path out of this value.
# Use your deployed FastAPI origin in Vercel's environment variables.
VITE_API_URL=http://127.0.0.1:8000
# Example production value:
# VITE_API_URL=https://your-backend.example.com

# Public Supabase project settings. The anon key is exposed in the browser by design.
# Never use a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
