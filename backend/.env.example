# MongoDB connection string. Use a local URI or a URI from your MongoDB provider.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=portfolio

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production, set this to the exact Vercel origin, e.g. https://your-site.vercel.app.

# Gmail SMTP contact form delivery. Create an App Password in your Google Account.
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_TO=shanmukhameda20@gmail.com

# Supabase project settings. The anon/publishable key is safe for Auth API verification.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Server-only Supabase Storage credentials. Never expose this key in Vite variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=portfolio-assets
# Comma-separated emails permitted to use the admin dashboard.
SUPABASE_ADMIN_EMAILS=admin@example.com
